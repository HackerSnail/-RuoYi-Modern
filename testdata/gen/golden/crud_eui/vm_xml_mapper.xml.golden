<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.GenDemoMapper">
    
    <resultMap type="GenDemo" id="GenDemoResult">
        <result property="id"    column="id"    />
        <result property="userName"    column="user_name"    />
        <result property="aCount"    column="a_count"    />
        <result property="status"    column="status"    />
        <result property="price"    column="price"    />
        <result property="birthday"    column="birthday"    />
        <result property="createBy"    column="create_by"    />
    </resultMap>

    <sql id="selectGenDemoVo">
        select id, user_name, a_count, status, price, birthday, create_by from sys_gen_demo
    </sql>

    <select id="selectGenDemoList" parameterType="GenDemo" resultMap="GenDemoResult">
        <include refid="selectGenDemoVo"/>
        <where>  
            <if test="userName != null  and userName != ''"> and user_name like concat('%', #{userName}, '%')</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectGenDemoById" parameterType="Long" resultMap="GenDemoResult">
        <include refid="selectGenDemoVo"/>
        where id = #{id}
    </select>

    <insert id="insertGenDemo" parameterType="GenDemo" useGeneratedKeys="true" keyProperty="id">
        insert into sys_gen_demo
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userName != null and userName != ''">user_name,</if>
            <if test="aCount != null">a_count,</if>
            <if test="status != null">status,</if>
            <if test="price != null">price,</if>
            <if test="birthday != null">birthday,</if>
            <if test="createBy != null">create_by,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userName != null and userName != ''">#{userName},</if>
            <if test="aCount != null">#{aCount},</if>
            <if test="status != null">#{status},</if>
            <if test="price != null">#{price},</if>
            <if test="birthday != null">#{birthday},</if>
            <if test="createBy != null">#{createBy},</if>
         </trim>
    </insert>

    <update id="updateGenDemo" parameterType="GenDemo">
        update sys_gen_demo
        <trim prefix="SET" suffixOverrides=",">
            <if test="userName != null and userName != ''">user_name = #{userName},</if>
            <if test="aCount != null">a_count = #{aCount},</if>
            <if test="status != null">status = #{status},</if>
            <if test="price != null">price = #{price},</if>
            <if test="birthday != null">birthday = #{birthday},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteGenDemoById" parameterType="Long">
        delete from sys_gen_demo where id = #{id}
    </delete>

    <delete id="deleteGenDemoByIds" parameterType="String">
        delete from sys_gen_demo where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>