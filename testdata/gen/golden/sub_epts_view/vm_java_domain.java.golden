package com.ruoyi.system.domain;

import java.util.List;
import org.apache.commons.lang3.builder.ToStringBuilder;
import org.apache.commons.lang3.builder.ToStringStyle;
import com.ruoyi.common.annotation.Excel;
import com.ruoyi.common.core.domain.BaseEntity;

/**
 * 生成演示对象 sys_gen_demo
 * 
 * @author ruoyi
 * @date 2026-01-01
 */
public class GenDemo extends BaseEntity
{
    private static final long serialVersionUID = 1L;

    /** 订单ID */
    @Excel(name = "订单ID")
    private Long orderId;

    /** 订单名称 */
    @Excel(name = "订单名称")
    private String orderName;

    /** 生成明细信息 */
    private List<GenDemoDetail> genDemoDetailList;

    public void setOrderId(Long orderId) 
    {
        this.orderId = orderId;
    }

    public Long getOrderId() 
    {
        return orderId;
    }

    public void setOrderName(String orderName) 
    {
        this.orderName = orderName;
    }

    public String getOrderName() 
    {
        return orderName;
    }

    public List<GenDemoDetail> getGenDemoDetailList()
    {
        return genDemoDetailList;
    }

    public void setGenDemoDetailList(List<GenDemoDetail> genDemoDetailList)
    {
        this.genDemoDetailList = genDemoDetailList;
    }

    @Override
    public String toString() {
        return new ToStringBuilder(this,ToStringStyle.MULTI_LINE_STYLE)
            .append("orderId", getOrderId())
            .append("orderName", getOrderName())
            .append("remark", getRemark())
            .append("createTime", getCreateTime())
            .append("genDemoDetailList", getGenDemoDetailList())
            .toString();
    }
}
